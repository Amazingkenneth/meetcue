{
  "name": "meetcue-workspace",
  "version": "0.3.1",
  "private": true,
  "description": "MeetCue meeting prompter and interview practice tool",
  "license": "MIT",
  "workspaces": [
    "app/ui",
    "docs"
  ],
  "scripts": {
    "dev": "npm -w app/ui run dev",
    "dev:mock": "npm -w app/ui run dev:mock",
    "build": "npm -w app/ui run build",
    "test": "npm -w app/ui run test",
    "lint": "npm -w app/ui run lint",
    "typecheck": "npm -w app/ui run typecheck",
    "check:locales": "node scripts/check-locales.mjs",
    "check:versions": "node scripts/check-versions.mjs",
    "docs:dev": "npm -w docs run dev",
    "docs:build": "npm -w docs run build",
    "docs:preview": "npm -w docs run preview",
    "docs:lint": "npm -w docs run lint",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4"
  },
  "engines": {
    "node": ">=20"
  }
}
