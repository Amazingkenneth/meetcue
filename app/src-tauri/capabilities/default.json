{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Everything the MeetCue windows may do. Each app command must be listed here.",
  "windows": [
    "overlay",
    "settings",
    "wizard",
    "practice",
    "review"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-close",
    "allow-get-app-info",
    "allow-get-settings",
    "allow-save-settings",
    "allow-list-devices",
    "allow-credential-status",
    "allow-set-credential",
    "allow-delete-credential",
    "allow-verify-provider",
    "allow-list-models",
    "allow-get-pricing",
    "allow-refresh-pricing",
    "allow-estimate-cost",
    "allow-provider-hosts",
    "allow-audio-preview",
    "allow-start-session",
    "allow-stop-session",
    "allow-toggle-capture",
    "allow-user-action",
    "allow-session-history",
    "allow-set-panel-mode",
    "allow-set-always-on-top",
    "allow-reset-panel-position",
    "allow-open-window",
    "allow-open-url",
    "allow-hotkey-status",
    "allow-recent-logs",
    "allow-run-probe",
    "allow-probe-history",
    "allow-usage-summary",
    "allow-export-usage-csv",
    "allow-diagnostics-preview",
    "allow-export-diagnostics",
    "allow-import-material",
    "allow-practice-import",
    "allow-practice-sample",
    "allow-list-voices",
    "allow-preview-voice",
    "allow-practice-classify",
    "allow-practice-start",
    "allow-practice-control",
    "allow-practice-reports",
    "allow-practice-report",
    "allow-export-report"
  ]
}
